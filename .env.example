# Copy to .env.local (or set in Vercel → Settings → Environment Variables).
# Leave empty to run with demo data.
#
# Connection string of the read-only `pharmalink_public_api` login from Sein.
# Use Supabase's pooler on port 6543. Server only: never prefix with NEXT_PUBLIC_.
# Example shape (not real):
# postgresql://pharmalink_public_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
PHARMALINK_PUBLIC_DATABASE_URL=
